/* ============================================================
 * 明亮科研工程风配色（专为 PPT 展示与学术论文插图优化）
 * 高对比度白底浅灰卡片 + 深灰文字 + 工程蓝/临床红功能区分
 * ============================================================ */

/* 基础主题 */
QWidget {
    background-color: #f4f6f9;
    color: #1f2937;
    font-family: "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #eef2f6;
}

QLabel {
    background-color: transparent;
    color: #1f2937;
}

/* 卡片分组框 */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 600;
    color: #0f3d66;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 1px 8px;
    color: #0f3d66;
    background-color: #ffffff;
    border: 1px solid #d8e1eb;
    border-radius: 4px;
}

/* 顶部状态栏 */
QGroupBox#statusPanel {
    background-color: #ffffff;
    border: 1px solid #bfccd9;
}

QGroupBox#statusPanel::title {
    color: #334155;
    background-color: #f8fafc;
}

QLabel[role="statusText"] {
    color: #1e293b;
    font-weight: 600;
}

QLabel[role="modeText"] {
    color: #0b5394;
    font-weight: 700;
}

QLabel#statusIndicator,
QLabel#modeIndicator {
    border-radius: 6px;
}

QLabel#statusIndicator[status="offline"] {
    background-color: #dc2626;
    border: 1px solid #991b1b;
}

QLabel#statusIndicator[status="online"] {
    background-color: #16a34a;
    border: 1px solid #15803d;
}

QLabel#modeIndicator[status="active"] {
    background-color: #2563eb;
    border: 1px solid #1d4ed8;
}

QLabel#timeLabel {
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    font-family: "JetBrains Mono", "Consolas", monospace;
}

/* 左侧控制栏与中间实验记录栏 */
QGroupBox#sidebarPanel,
QGroupBox#experimentPanel {
    background-color: #ffffff;
}

QLabel[role="sectionTitle"] {
    color: #0f4c81;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 2px 1px 2px;
}

QLabel[role="panelHint"] {
    color: #475569;
    font-size: 11px;
    padding: 2px 1px 4px 1px;
}

/* 普通控制按钮 */
QPushButton {
    min-height: 24px;
    padding: 6px 10px;
    color: #1e293b;
    background-color: #f8fafc;
    border: 1px solid #94a3b8;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton:hover {
    color: #0f172a;
    background-color: #e8f1fb;
    border-color: #2563eb;
}

QPushButton:pressed {
    color: #ffffff;
    background-color: #1d4ed8;
    border-color: #1e40af;
}

QPushButton:checked {
    color: #ffffff;
    background-color: #1d6fa5;
    border: 1px solid #15527c;
    font-weight: 700;
}

QPushButton:disabled {
    color: #94a3b8;
    background-color: #f1f5f9;
    border-color: #cbd5e1;
}

/* 醒目的安全停止按钮 */
QPushButton#safetyStopButton {
    min-height: 32px;
    color: #ffffff;
    background-color: #dc2626;
    border: 1px solid #991b1b;
    font-weight: 700;
    font-size: 14px;
}

QPushButton#safetyStopButton:hover {
    background-color: #b91c1c;
    border-color: #7f1d1d;
}

QPushButton#safetyStopButton:checked {
    background-color: #b91c1c;
    border: 2px solid #7f1d1d;
}

/* CSV 记录开始/停止按钮 */
QPushButton#recordStartButton {
    color: #ffffff;
    background-color: #15803d;
    border: 1px solid #166534;
    font-weight: 600;
}

QPushButton#recordStartButton:hover {
    background-color: #166534;
}

QPushButton#recordStopButton {
    color: #ffffff;
    background-color: #b91c1c;
    border: 1px solid #991b1b;
    font-weight: 600;
}

QPushButton#recordStopButton:hover {
    background-color: #991b1b;
}

/* 事件打标按钮 */
QPushButton[role="tagButton"] {
    color: #1e3a8a;
    background-color: #eff6ff;
    border: 1px solid #93c5fd;
    font-weight: 600;
}

QPushButton[role="tagButton"]:hover {
    color: #ffffff;
    background-color: #2563eb;
    border-color: #1d4ed8;
}

/* 输入框、下拉框、数值框 */
QLineEdit,
QComboBox,
QDoubleSpinBox {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #94a3b8;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 22px;
}

QLineEdit:focus,
QComboBox:focus,
QDoubleSpinBox:focus {
    border: 1.5px solid #2563eb;
}

QComboBox:disabled,
QLineEdit:disabled {
    color: #64748b;
    background-color: #f1f5f9;
    border-color: #cbd5e1;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111827;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
    border: 1px solid #94a3b8;
}

/* 视觉节拍引导进度条 */
QProgressBar {
    background-color: #e2e8f0;
    border: 1px solid #94a3b8;
    border-radius: 6px;
    height: 18px;
    text-align: center;
    color: #0f172a;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 5px;
}

/* 数据展示卡片 */
QGroupBox#dataPanel {
    background-color: #ffffff;
}

QLabel[role="cardTitle"] {
    color: #0f4c81;
    font-weight: 700;
}

QLabel[role="metric"] {
    color: #111827;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-weight: 500;
}

/* 关节状态表格（白底斑马纹 + 清晰边框，论文缩图清晰可读） */
QTableWidget {
    color: #111827;
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    gridline-color: #cbd5e1;
    border: 1px solid #94a3b8;
    border-radius: 5px;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
    outline: none;
    font-family: "JetBrains Mono", "Microsoft YaHei", sans-serif;
}

QHeaderView::section {
    color: #0f172a;
    background-color: #e8eef5;
    padding: 6px 4px;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #94a3b8;
    font-weight: 700;
}

QTableWidget::item {
    padding: 3px;
    border: none;
}

QTableCornerButton::section {
    background-color: #e8eef5;
    border: none;
}

/* 运行日志框 */
QTextEdit {
    color: #1e293b;
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 6px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    selection-background-color: #bfdbfe;
}

/* 分割条 */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
    margin: 10px 1px;
    border-left: 1px solid #cbd5e1;
}

QSplitter::handle:vertical {
    height: 6px;
    margin: 1px 10px;
    border-top: 1px solid #cbd5e1;
}

QSplitter::handle:hover {
    background-color: #dbeafe;
}

/* 滚动条 */
QScrollBar:vertical {
    width: 10px;
    margin: 2px;
    background: #f1f5f9;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    background: #94a3b8;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #64748b;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 2px;
    background: #f1f5f9;
}

QScrollBar::handle:horizontal {
    min-width: 30px;
    background: #94a3b8;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #64748b;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QToolTip {
    color: #0f172a;
    background-color: #ffffff;
    border: 1px solid #94a3b8;
    padding: 5px;
}
